# Copy to /opt/openreply/.env and chmod 600. Never commit the populated file.
NEXTAUTH_URL=https://openreply.example.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
CRON_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
REDIS_PASSWORD=generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql://openreply:POSTGRES_PASSWORD@postgres:5432/openreply
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

RESEND_API_KEY=re_replace
EMAIL_FROM=OpenReply <login@example.com>
AUTH_ALLOWED_EMAILS=owner@example.com
# Domain allowlist (combined with AUTH_ALLOWED_EMAILS, either grants access).
# Example: yoyaku.fr,interwave.live,objects.press
AUTH_ALLOWED_DOMAINS=
# An exact, unexpired workspace invitation also authorizes that address to sign
# in. Use invitations for reviewers/partners instead of opening their domain.
# Single-organization mode: new allowed users join the oldest existing
# workspace as MEMBER instead of creating their own empty one.
AUTH_JOIN_EXISTING_WORKSPACE=true
# Optional domain-to-workspace routing for multi-organization instances:
# an email whose domain matches an entry joins that named workspace (as
# EDITOR) instead of the oldest one. Unmapped domains fall back to the oldest
# workspace; a configured target that does not exist fails closed.
# Example: objects.press=Objects Presswerk
AUTH_DOMAIN_WORKSPACES=

META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=replace
INSTAGRAM_APP_SECRET=replace
FACEBOOK_APP_SECRET=replace
WEBHOOK_VERIFY_TOKEN=generate-with-openssl-rand-hex-32

# Shared only with the loopback consumer /opt/yoyaku-sav-engine/.env.
SAV_BRIDGE_TOKEN=generate-with-openssl-rand-hex-32
SAV_IG_ACCOUNT_USERNAMES=yoyaku.fr,yoyakurecordstore
SAV_SENDS_PER_HOUR=10

OPENREPLY_PORT=3048
OPENREPLY_IMAGE_TAG=local
