# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
# Dedicated M2M secret for the signed, paginated publication-proof export.
# Falls back to CRON_SECRET for compatibility; use a distinct 32+ byte value in production.
PUBLICATION_EXPORT_SECRET=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>
# Optional self-hosting guard. When set, only these comma-separated addresses
# can request a magic link. Leave empty to preserve public signup behavior.
AUTH_ALLOWED_EMAILS=

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Loopback-only Instagram SAV bridge. Generate once with `openssl rand -hex 32`
# and install the exact same value in yoyaku-sav-engine's .env.
SAV_BRIDGE_TOKEN=replace-with-a-strong-random-secret
SAV_IG_ACCOUNT_USERNAMES=yoyaku.fr,yoyakurecordstore
SAV_SENDS_PER_HOUR=10

# Google sign-in (optional). Create an OAuth client in Google Cloud Console
# with redirect URI <NEXTAUTH_URL>/api/auth/callback/google. Leaving these
# empty hides the Google button and keeps magic-link login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional domain allowlist, combined with AUTH_ALLOWED_EMAILS (either match
# grants access). Example: yoyaku.fr,interwave.live
AUTH_ALLOWED_DOMAINS=
# Single-organization mode: new allowed users join the oldest existing
# workspace as MEMBER instead of creating their own empty one.
AUTH_JOIN_EXISTING_WORKSPACE=false
# Optional domain-to-workspace routing for multi-organization instances:
# an email whose domain matches an entry joins that named workspace (as
# MEMBER) instead of the oldest one. Unmapped domains and workspaces that
# do not exist yet fall back to the oldest-workspace default.
# Example: objects.press=Objects Presswerk
AUTH_DOMAIN_WORKSPACES=
# Automatic ADMIN policy, replayed at every session. A domain may target more
# than one workspace; OWNER memberships are never downgraded.
AUTH_DOMAIN_ADMIN_WORKSPACES=yoyaku.fr=id:CHANGE_ME|id:CHANGE_ME,objects.press=id:CHANGE_ME
# Host-level tenant pin. Requests on the Objects hostname cannot select or read
# another workspace, even with a stale switcher cookie.
OPENREPLY_HOST_WORKSPACES=openreply.objects.press=id:CHANGE_ME
OPENREPLY_ALLOWED_HOSTS=openreply.yoyaku.fr,openreply.objects.press

# Release-to-campaign sync (optional). The shop-side feed is
# GET <site>/wp-json/yoyaku/v1/release-events. Campaigns are created inactive
# unless RELEASE_SYNC_AUTO_ACTIVATE=true.
RELEASE_SYNC_ENABLED=false
RELEASE_EVENTS_URL=
RELEASE_EVENTS_KEY=
RELEASE_SYNC_IG_USERNAME=yoyakurecordstore
RELEASE_SYNC_AUTO_ACTIVATE=false
ATTACH_NEXT_REEL_ENABLED=false
CALENDAR_INTENT_SYNC_ENABLED=false
CALENDAR_INTENTS_URL=https://admin.yoyaku.fr/api/internal/publications/automation-intents
CALENDAR_INTENTS_SECRET=
# Stable tenant IDs only. Missing either mapping makes the sync fail closed.
CALENDAR_WORKSPACE_IDS=yoyaku=CHANGE_ME,objects=CHANGE_ME
